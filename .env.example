VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — enables the "Sync to Google Calendar" feature. Leave unset to disable it entirely.
# See the "Google Calendar sync setup" section in README.md.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CALENDAR_ID=your-shared-calendar-id@group.calendar.google.com
