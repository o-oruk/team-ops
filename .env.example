VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — enables the "Add to Google Calendar" button. Leave unset to hide the feature entirely.
# There's nothing else to configure: the "Amana Vision" calendar is created in each user's own
# Google account the first time they sync. See "Google Calendar setup" in README.md.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
